<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tools-only project: exists so the archspec native CLI is restored from NuGet
    and its path is exposed through the $(ArchspecPath) MSBuild property.
    Nothing is compiled. The package's build/archspec.props imports cleanly on
    MSBuild 18 (archspec 0.6.81+) but resolves the RID at evaluation time before
    the SDK defines NETCoreSdkRuntimeIdentifier, so tools/Directory.Build.props
    seeds _ArchspecRid (see the comment there; tracks archspec#42).
    The version comes from Central Package Management (Directory.Packages.props),
    so it is not duplicated here.

    Resolve the binary with:
      dotnet msbuild tools/archspec/ArchspecTools.csproj -t:_ResolveArchspecPath -getProperty:ArchspecPath

    Run the instrumented architecture audit with:
      ./build/archspec/audit.sh
  -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- No sources is by design for a tools-only project. -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="archspec" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="_ResolveArchspecPath">
    <Error Condition="'$(ArchspecPath)' == ''" Text="archspec: $(ArchspecPath) is empty — did the archspec package props set it? Restore tools/archspec/ArchspecTools.csproj first." />
  </Target>

  <Target Name="ArchspecVersion" DependsOnTargets="_ResolveArchspecPath">
    <Exec Command="&quot;$(ArchspecPath)&quot; --version" />
  </Target>

  <!-- CI gate: archspec verify with strict severity against the repo root spec. -->
  <Target Name="ArchspecVerify" DependsOnTargets="_ResolveArchspecPath">
    <Exec Command="&quot;$(ArchspecPath)&quot; verify --strict" WorkingDirectory="$(RepoRoot)" />
  </Target>

</Project>
