<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tools-only project: exists so the archspec native CLI is restored from NuGet
    and its path is exposed through the $(ArchspecPath) MSBuild property.
    Nothing is compiled.

    The package's build/archspec.props cannot be imported with MSBuild 18
    (dotnet SDK 10.x): it carries a bare <Error> element under <Project>,
    which MSBuild now refuses outright. Until archspec ships a fixed props
    file, this project consumes the package with ExcludeAssets="build" and
    mirrors the props file's RID selection in the _ResolveArchspecPath
    target. The version comes from Central Package Management
    (Directory.Packages.props), so it is not duplicated here.

    Resolve the binary with:
      dotnet msbuild tools/archspec/ArchspecTools.csproj -t:_ResolveArchspecPath -getProperty:ArchspecPath

    Run the instrumented architecture audit with:
      ./build/archspec/audit.sh
  -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- No sources is by design for a tools-only project. -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="archspec" PrivateAssets="all" ExcludeAssets="build" />
    <!-- CPM's PackageVersion item for archspec, isolated for expansion. -->
    <_ArchspecPackageVersion Include="@(PackageVersion->WithMetadataValue('Identity', 'archspec'))" />
  </ItemGroup>

  <!-- RID selection mirrors build/archspec.props from the package. -->
  <Target Name="_ResolveArchspecPath">
    <PropertyGroup>
      <_ArchspecVersion>@(_ArchspecPackageVersion->Metadata('Version'))</_ArchspecVersion>
      <_ArchspecPackageRoot Condition="'$(_ArchspecVersion)' != ''">$(NuGetPackageRoot)archspec/$(_ArchspecVersion)/</_ArchspecPackageRoot>
      <_ArchspecRid Condition="'$(_ArchspecRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_ArchspecRid>
      <ArchspecPath Condition="'$(_ArchspecRid)' == 'linux-x64' or '$(_ArchspecRid)' == 'linux-musl-x64'">$(_ArchspecPackageRoot)runtimes/linux-x64/native/archspec</ArchspecPath>
      <ArchspecPath Condition="'$(_ArchspecRid)' == 'linux-arm64'">$(_ArchspecPackageRoot)runtimes/linux-arm64/native/archspec</ArchspecPath>
      <ArchspecPath Condition="'$(_ArchspecRid)' == 'osx-x64'">$(_ArchspecPackageRoot)runtimes/osx-x64/native/archspec</ArchspecPath>
      <ArchspecPath Condition="'$(_ArchspecRid)' == 'osx-arm64'">$(_ArchspecPackageRoot)runtimes/osx-arm64/native/archspec</ArchspecPath>
      <ArchspecPath Condition="'$(_ArchspecRid)' == 'win-x64'">$(_ArchspecPackageRoot)runtimes/win-x64/native/archspec.exe</ArchspecPath>
    </PropertyGroup>
    <Error Condition="'$(ArchspecPath)' == ''" Text="archspec: no restored archspec package or no binary for .NET SDK runtime identifier '$(_ArchspecRid)'. Restore tools/archspec/ArchspecTools.csproj first; shipped RID set: linux-x64 (static musl, also linux-musl-x64), linux-arm64, osx-x64, osx-arm64, win-x64." />
  </Target>

  <Target Name="ArchspecVersion" DependsOnTargets="_ResolveArchspecPath">
    <Exec Command="&quot;$(ArchspecPath)&quot; --version" />
  </Target>

  <!-- CI gate: archspec verify with strict severity against the repo root spec. -->
  <Target Name="ArchspecVerify" DependsOnTargets="_ResolveArchspecPath">
    <Exec Command="&quot;$(ArchspecPath)&quot; verify --strict" WorkingDirectory="$(RepoRoot)" />
  </Target>

</Project>
