<Project>

  <Import Project="../Directory.Build.props"/>

  <!-- archspec tools-package RID seeding (temporary consumer-side workaround,
       archspec#37 still open in 0.6.81): build/archspec.props reads
       $(NETCoreSdkRuntimeIdentifier) at evaluation time, but nuget.g.props —
       which imports it — evaluates before the SDK defines that property, so the
       package's RID table never fires. RuntimeInformation's RID is available at
       any evaluation point and matches the props table's spellings. -->
  <PropertyGroup>
    <_ArchspecRid Condition="'$(_ArchspecRid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</_ArchspecRid>
  </PropertyGroup>

</Project>
